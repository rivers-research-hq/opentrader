--- /dev/null
+++ b/strategies/shadow_driver.py
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""Shadow driver — the recurring accrual that closes the improvement loop (#157).
+
+Reads lanes_state.json (written by lanes.py cron 17:30 weekdays), accrues each
+lane's latest 1-day return as one (regime, expert) impact into the router
+track, and fires RegimeRouter.step() so weights evolve on forward evidence.
+PAPER — never touches live order flow (V06).
+
+Single-writer (#155): all live_router_state.json I/O via router_state.py.
+Guards (from evolve_weights.py): FLOOR_SHARE=0.20, CAP=0.5, MIN_EVIDENCE=5.
+Same-day double-accrual guard: records asof; second --once same day is a no-op.
+
+Usage:
+  python -m strategies.shadow_driver --dry            # default: print, no write
+  python -m strategies.shadow_driver --once           # accrue + step + write
+  python -m strategies.shadow_driver --state-dir DIR  # override data dir
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+from strategies.router_state import read_router_state, write_router_state
+from strategies.evolve_weights import FLOOR_SHARE, CAP
+from mot.mixture import RegimeRouter
+
+PROJECT = Path(__file__).resolve().parent.parent
+MIN_EVIDENCE = 5
+SHIFT = 0.1
+
+
+def _load_lanes(state_dir: Path) -> tuple[dict, str]:
+    """Read lanes_state.json (read-only). Returns ({expert: {ret, regime}}, asof)."""
+    p = state_dir / "lanes_state.json"
+    if not p.exists():
+        return {}, ""
+    try:
+        raw = json.loads(p.read_text())
+    except Exception:
+        return {}, ""
+    asof = str(raw.get("asof", ""))
+    out = {}
+    for name, r in raw.get("lanes", {}).items():
+        ret = r.get("latest_1d_ret")
+        regime = r.get("regime")
+        if ret is None or regime not in ("up", "down"):
+            continue
+        out[name] = {"ret": float(ret), "regime": regime}
+    return out, asof
+
+
+def _validated_windows(track: dict, min_evidence: int = MIN_EVIDENCE):
+    """(regime, expert) pairs with >= min_evidence *forward* windows.
+
+    Gates on fwd_n (driver-accrued count, starts at 0) rather than n, which
+    includes the static seed. Without this, the seed's n already satisfies
+    MIN_EVIDENCE and step() fires on day one, collapsing the floor.
+    """
+    pairs = []
+    for regime, experts in track.items():
+        if regime not in ("up", "down"):
+            continue
+        for expert, rec in experts.items():
+            if expert == "rule":
+                continue
+            if int(rec.get("fwd_n", 0)) >= min_evidence:
+                pairs.append((regime, expert))
+    return pairs
+
+
+def _apply_floor(weights: dict, floor_share: float = FLOOR_SHARE) -> dict:
+    """Enforce rule floor: RegimeRouter.step() sets rule=1-expert (single-expert
+    invariant that breaks with 9 experts). Clips expert weights proportionally
+    so the rule keeps >= floor_share."""
+    out = {}
+    for regime in ("up", "down"):
+        w = dict(weights.get(regime, {"rule": 1.0}))
+        w.setdefault("rule", 1.0)
+        expert_sum = sum(w.get(e, 0.0) for e in w if e != "rule")
+        if expert_sum > (1.0 - floor_share):
+            excess = expert_sum - (1.0 - floor_share)
+            for e in [e for e in w if e != "rule"]:
+                w[e] -= excess * (w[e] / expert_sum)
+        w["rule"] = max(floor_share, 1.0 - sum(w.get(e, 0.0) for e in w if e != "rule"))
+        out[regime] = w
+    return out
+
+
+def step(dry: bool = False, state_dir: str | None = None) -> dict:
+    """One driver cycle: read lanes -> accrue -> step -> persist."""
+    sdir = Path(state_dir) if state_dir else PROJECT / "data"
+    lanes, asof = _load_lanes(sdir)
+    if not lanes:
+        print("[shadow] no lanes artifact found — nothing to accrue")
+        return {}
+
+    state = read_router_state(str(sdir))
+
+    # Same-day double-accrual guard
+    last_asof = state.get("shadow_last_asof", "")
+    if asof and last_asof == asof and not dry:
+        print(f"[shadow] already processed asof {asof} — skipping (double-accrual guard)")
+        return {"skipped": True, "asof": asof}
+
+    track = state.setdefault("track", {})
+
+    # 1. accrue each lane's latest 1-day return
+    accruals = []
+    for name, info in lanes.items():
+        regime = info["regime"]
+        t = track.setdefault(regime, {})
+        rec = t.setdefault(name, {"sum": 0.0, "n": 0, "fwd_n": 0})
+        rec["sum"] = float(rec.get("sum", 0.0)) + info["ret"]
+        rec["n"] = int(rec.get("n", 0)) + 1
+        rec["fwd_n"] = int(rec.get("fwd_n", 0)) + 1
+        accruals.append((name, regime, info["ret"]))
+
+    # 2. delegate to the real RegimeRouter.step()
+    router = RegimeRouter(min_evidence=MIN_EVIDENCE, shift=SHIFT, cap=CAP)
+    router.track = track
+    router.weights = state.get("weights", {})
+    validated = _validated_windows(track)
+    router.step({(r, e): 1 for r, e in validated})
+    new_weights = _apply_floor(router.weights)
+
+    # 3. report
+    print(f"[shadow] lanes asof {sdir / 'lanes_state.json'}: {len(lanes)} lanes")
+    for name, regime, ret in sorted(accruals):
+        print(f"  accrue {name} [{regime}] impact={ret:+.6f}")
+    print(f"[shadow] validated windows (n>={MIN_EVIDENCE}): {len(validated)}")
+    for regime, expert in sorted(validated):
+        print(f"  step {regime}/{expert}")
+    old_weights = state.get("weights", {})
+    print("[shadow] weight deltas (old -> new):")
+    for regime in ("up", "down"):
+        old = old_weights.get(regime, {})
+        new = new_weights.get(regime, {})
+        for e in sorted(set(old) | set(new)):
+            o, n = old.get(e, 0.0), new.get(e, 0.0)
+            if abs(n - o) > 1e-9:
+                print(f"  {regime}/{e}: {o:.4f} -> {n:.4f} ({n - o:+.4f})")
+
+    if dry:
+        print("[shadow] dry run — no write")
+        return {"accruals": accruals, "validated": validated,
+                "old_weights": old_weights, "new_weights": new_weights}
+
+    # 4. persist through the single-writer
+    state["weights"] = new_weights
+    state["shadow_last_asof"] = asof
+    state["note"] = ("SHADOW DRIVER (#157): per-lane forward impact accrued + "
+                     "RegimeRouter.step() fired. PAPER — not live order flow.")
+    write_router_state(state, state_dir=str(sdir))
+    print(f"[shadow] wrote {sdir / 'live_router_state.json'}")
+    return {"accruals": accruals, "validated": validated,
+            "old_weights": old_weights, "new_weights": new_weights}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dry", action="store_true", default=True,
+                    help="print would-be accrual + weight deltas, write nothing (default)")
+    ap.add_argument("--once", action="store_true",
+                    help="accrue + step + write (cron mode)")
+    ap.add_argument("--state-dir", default=None,
+                    help="override the data dir (default: <project>/data)")
+    args = ap.parse_args()
+    dry = not args.once
+    step(dry=dry, state_dir=args.state_dir)
+
+
+if __name__ == "__main__":
+    main()
