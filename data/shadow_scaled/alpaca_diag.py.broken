#!/usr/bin/env python3
"""Alpaca data-API diagnostic. READ-ONLY. Captures RAW responses (no keys)."""
import json, os, sys
from pathlib import Path
from urllib.request import Request, urlopen
from urllib.error import URLError

def load():
    key, secret = "", ""
    p = Path("/home/mrc/opentrader/config/alt_data_keys.json")
    if p.exists():
        try:
            d = json.loads(p.read_text())
            key, secret = d.get("ALPACA_KEY",""), d.get("ALPACA_SECRET","")
        except Exception: pass
    return key or os.environ.get("ALPACA_KEY",""), secret or os.environ.get("ALPACA_SECRET","")

def raw(url, hdr):
    req = Request(url, headers=hdr)
        with urlopen(req, timeout=15) as r:
            return r.status, r.read().decode()[:300]
    except URLError as e:
        body = ""
        try: body = e.read().decode()[:300]
        except Exception: pass
        return getattr(e,"code",None), body
    except Exception as e:
        return None, str(e)

k,s = load()
print(f"alpaca keys present: {bool(k) and bool(s)}")
hdr = {"APCA-API-KEY-ID": k, "APCA-API-SECRET-KEY": s}
print("\n-- batch quotes (AAPL,RIVN,WULF) --")
st, body = raw("https://data.alpaca.markets/v2/stocks/quotes?symbols=AAPL,RIVN,WULF", hdr)
print(f"  status={st}\n  body={body!r}")
print("\n-- single bars AAPL 1Day limit=5 --")
st, body = raw("https://data.alpaca.markets/v2/stocks/AAPL/bars?timeframe=1Day&limit=5&adjust=all", hdr)
print(f"  status={st}\n  body={body!r}")
print("\n-- clock (data API health) --")
st, body = raw("https://data.alpaca.markets/v2/stocks/aapl?limit=1", hdr)
print(f"  status={st}\n  body={body!r}")
