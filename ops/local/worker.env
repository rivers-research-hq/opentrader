# Local worker — single source of truth. Edit here, not in the unit files.
#
# Model: Qwen3-Coder-30B-A3B UD-Q5_K_XL (unsloth imatrix quant). Chosen over the
# plain Q5_K_M at equal bytes — gate 34/35 vs 33/35, throughput 22.5 vs 21.8 t/s.
# Measurements: docs/agents/research/local-worker-measurements-2026-09-15.md
MODEL_PATH=/var/tmp/llama-models/Qwen3-Coder-30B-A3B-Instruct-UD-Q5_K_XL.gguf
MODEL_ALIAS=qwen3-coder-30b-a3b-ud
PORT=5808
# 64K verified at q8_0 KV: needle 10/10 at 54K, 14.5GB of 17.2GB VRAM.
CTX=65536
N_GPU_LAYERS=99
# MoE: 21.7GB model vs 16GB VRAM — 28/48 layers' experts stay in RAM.
# Keep this on its own line: systemd's EnvironmentFile does NOT strip inline
# comments, so `N_CPU_MOE=28  # ...` reaches llama-server as the literal value.
N_CPU_MOE=28
THREADS=8
