#!/usr/bin/env python3
"""Spawn and supervise an opencode background subagent with stall detection.

Stall = the subagent process is alive but its log has not grown for
stall_seconds. On stall, the helper marks the state file STALLED and kills the
process (unless --no-kill). State lives at <log_dir>/<label>.state as JSON.
"""

import argparse
import json
import os
import shlex
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def read_state(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def write_state(path: Path, state: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2))
    # keep a sidecar so mtime-based progress checks work even when the
    # process is gone (status action)
    path.touch()


def tail_of(log: Path, lines: int = 25) -> str:
    try:
        text = log.read_text(errors="replace")
        return "".join(text.splitlines(keepends=True)[-lines:]).strip()
    except Exception:
        return ""


def spawn(args) -> dict:
    label = args.label
    log_dir = Path(args.log_dir) / label
    log_dir.mkdir(parents=True, exist_ok=True)
    log = log_dir / "run.log"
    state = read_state(log_dir / "state.json")
    if state.get("pid"):
        pid = state["pid"]
        if _pid_alive(pid):
            return {"error": f"subagent '{label}' already running (pid {pid})"}

    if args.cmd:
        cmd = shlex.split(args.cmd)
    else:
        prompt = Path(args.prompt_file).read_text()
        cmd = ["opencode", "run", "--title", label]
        if args.model:
            cmd += ["--model", args.model]
        cmd.append(prompt)

    logf = open(log, "ab")
    try:
        proc = subprocess.Popen(
            cmd,
            cwd=args.cwd,
            stdin=subprocess.DEVNULL,
            stdout=logf,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    finally:
        logf.close()

    state = {
        "label": label,
        "pid": proc.pid,
        "state": "running",
        "spawned_at": now_iso(),
        "last_progress_at": time.time(),
        "log": str(log),
        "model": args.model or "default",
        "exit_code": None,
        "tail": "",
        "stall_seconds": args.stall_seconds,
    }
    write_state(log_dir / "state.json", state)

    # Self-detach a monitor so a stall is caught even when no caller keeps
    # watching. The monitor exits itself on completion/stall.
    monitor_cmd = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--action",
        "monitor",
        "--label",
        label,
        "--cwd",
        args.cwd,
        "--log-dir",
        args.log_dir,
        "--stall-seconds",
        str(args.stall_seconds),
        "--poll-seconds",
        str(args.poll_seconds),
    ]
    if args.no_kill:
        monitor_cmd.append("--no-kill")
    try:
        subprocess.Popen(
            monitor_cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass
    return state


def _notify(label: str, status: str, detail: str = "") -> None:
    """Push a completion/alert to the owner: desktop notification (Hyprland
    notify-send) plus a marker file. Best-effort; never raises."""
    try:
        urgency = "critical" if status in ("stalled", "killed", "crashed") else "normal"
        title = f"opentrader: {label} — {status}"
        body = (detail or "").strip().replace("\n", " ")[:220]
        subprocess.run(
            ["notify-send", "-u", urgency, title, body],
            timeout=10,
            capture_output=True,
        )
    except Exception:
        pass
    try:
        Path("/tmp/opencode").mkdir(exist_ok=True)
        marker = Path("/tmp/opencode") / f"alert_{label}_{status}.txt"
        marker.write_text(f"{now_iso()} {label} {status}\n{detail or ''}")
    except Exception:
        pass


def monitor(args) -> dict:
    """Detached supervision loop: exits when the subagent completes or stalls."""
    label = args.label
    log_dir = Path(args.log_dir) / label
    log = log_dir / "run.log"
    state_file = log_dir / "state.json"
    last_size = 0
    try:
        last_size = log.stat().st_size
    except FileNotFoundError:
        pass

    while True:
        state = read_state(state_file)
        pid = state.get("pid")
        if not pid or state.get("state") in ("completed", "stalled", "killed"):
            break
        alive = _pid_alive(pid)
        if not alive:
            state.update(
                {
                    "state": "completed",
                    "completed_at": now_iso(),
                    "exit_code": _exit_code(pid),
                    "tail": tail_of(log),
                }
            )
            write_state(state_file, state)
            _notify(
                label, "completed", f"exit_code={state['exit_code']}\n{state['tail']}"
            )
            break

        try:
            size = log.stat().st_size
        except FileNotFoundError:
            size = last_size
        if size > last_size:
            last_size = size
            state["last_progress_at"] = time.time()
            state["last_progress_iso"] = now_iso()
            write_state(state_file, state)

        idle = time.time() - state.get("last_progress_at", time.time())
        if idle >= args.stall_seconds:
            state.update(
                {
                    "state": "stalled",
                    "stalled_at": now_iso(),
                    "idle_seconds": int(idle),
                    "tail": tail_of(log),
                }
            )
            write_state(state_file, state)
            if not args.no_kill:
                try:
                    os.killpg(os.getpgid(pid), signal.SIGKILL)
                    state["killed_on_stall"] = True
                except Exception:
                    state["killed_on_stall"] = False
                write_state(state_file, state)
            _notify(
                label,
                "STALLED",
                f"idle={state.get('idle_seconds')}s killed_on_stall={state.get('killed_on_stall')}\n{state['tail']}",
            )
            break

        time.sleep(args.poll_seconds)

    return state


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _exit_code(pid: int) -> int | None:
    try:
        os.waitpid(pid, os.WNOHANG)
        return None
    except ChildProcessError:
        return None
    except Exception:
        return None


def status(args) -> dict:
    label = args.label
    log_dir = Path(args.log_dir) / label
    state_file = log_dir / "state.json"
    state = read_state(state_file)
    if not state:
        return {"label": label, "state": "not-found"}

    pid = state.get("pid")
    alive = bool(pid) and _pid_alive(pid)
    if alive:
        try:
            size = (log_dir / "run.log").stat().st_size
        except FileNotFoundError:
            size = 0
        idle = time.time() - state.get("last_progress_at", time.time())
        state.update(
            {
                "state": "running",
                "alive": True,
                "idle_seconds": int(idle),
                "log_bytes": size,
                "tail": tail_of(log_dir / "run.log"),
            }
        )
        if state.get("state") == "running" and idle > state.get("stall_seconds", 180):
            state["warning"] = (
                "STALLED-DETECTED (log not growing) - run kill or inspect"
            )
        write_state(state_file, state)
    else:
        state.update(
            {
                "alive": False,
                "tail": tail_of(log_dir / "run.log"),
            }
        )
        if state.get("state") == "running":
            state["state"] = "completed"
            state["completed_at"] = now_iso()
            write_state(state_file, state)
    return state


def kill(args) -> dict:
    label = args.label
    log_dir = Path(args.log_dir) / label
    state = read_state(log_dir / "state.json")
    pid = state.get("pid")
    if pid and _pid_alive(pid):
        try:
            os.killpg(os.getpgid(pid), signal.SIGKILL)
            state["state"] = "killed"
            state["killed_at"] = now_iso()
        except Exception as e:
            return {"error": str(e), "label": label}
    else:
        state["state"] = "killed"
        state["killed_at"] = now_iso()
    write_state(log_dir / "state.json", state)
    _notify(label, "killed", f"killed_at={state.get('killed_at')}")
    return state


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument(
        "--action", choices=["spawn", "monitor", "status", "kill"], required=True
    )
    ap.add_argument("--label", required=True)
    ap.add_argument("--prompt-file", default=None)
    ap.add_argument("--cwd", default=os.getcwd())
    ap.add_argument("--model", default=None)
    ap.add_argument(
        "--cmd",
        default=None,
        help="arbitrary command to supervise instead of `opencode run`",
    )
    ap.add_argument("--log-dir", default="/tmp/opencode/subagents")
    ap.add_argument("--stall-seconds", type=int, default=180)
    ap.add_argument("--poll-seconds", type=float, default=5.0)
    ap.add_argument("--no-kill", action="store_true")
    args = ap.parse_args()

    result = {"spawn": spawn, "monitor": monitor, "status": status, "kill": kill}[
        args.action
    ](args)
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
