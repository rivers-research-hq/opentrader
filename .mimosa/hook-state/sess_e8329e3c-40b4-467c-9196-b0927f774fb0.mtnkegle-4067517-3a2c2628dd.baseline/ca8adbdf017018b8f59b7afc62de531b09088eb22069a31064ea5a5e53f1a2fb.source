"""Query project.yaml for OpenTrader context — called by opentrader-context tool."""

import sys
import json
import yaml
from pathlib import Path

DATA_YAML = Path(__file__).resolve().parent.parent.parent / "data" / "project.yaml"

data = yaml.safe_load(open(DATA_YAML))

section = sys.argv[1]
key = sys.argv[2] if len(sys.argv) > 2 else None

if section == "all":
    result = data
elif section not in data:
    available = ", ".join(data.keys())
    print(f"ERROR: section '{section}' not found. Available: {available}")
    sys.exit(1)
else:
    result = data[section]

if key:
    if isinstance(result, list):
        result = next((item for item in result if item.get("id") == key), None)
        if result is None:
            print(f"ERROR: key '{key}' not found in '{section}'")
            print(
                f"Available ids: {', '.join(item.get('id', '?') for item in data[section])}"
            )
            sys.exit(1)
    elif key in result:
        result = result[key]
    else:
        print(f"ERROR: key '{key}' not found in '{section}'")
        print(f"Available keys: {', '.join(result.keys())}")
        sys.exit(1)

print(json.dumps(result, indent=2))
