import { tool } from "@opencode-ai/plugin"
import { join } from "path"

export default tool({
  description: "Query OpenTrader project context from data/project.yaml. Use to get port maps, service commands, config values, known bugs, or training params without loading large markdown files.",
  args: {
    section: tool.schema.string().describe("Section to query: services, exchange, model, debate, config, paths, known_bugs, training, or all"),
    key: tool.schema.string().optional().describe("Optional key or bug id within the section")
  },
  async execute(args, context) {
    const script = join(context.worktree, ".opencode/tools/_project_context.py")
    const keyArg = args.key ? ` "${args.key}"` : ""
    const result = await Bun.$`python3 ${script} "${args.section}"${keyArg}`.text()
    return result.trim()
  }
})
