#!/usr/bin/env python3
"""OpenTrader TUI — terminal mission control (replaces the Ink/Node tui).

Two screens:
  [1] Home  — every agent at a glance: FX lanes, registry experts, equities
              router experts, proposal loop; portfolio + performance; system
              health (watchdog, reconciliation, event windows, queue).
  [2] Forex — the practice book live: positions by owner tag, lane status,
              recent fills, central-bank event windows, the crash-test book.

Keys: 1 = Home, 2 = Forex, q = quit. Data refreshes automatically
(OANDA-dependent panels every 45s, files every 20s). The venue is
authoritative; the TUI is read-only — it never trades.

Style: dark slate theme, rounded panels, per-lane color identity:
  mom-k5 cyan · c08-fade green · h1-mom yellow · crash red · watchdog magenta

Run: /home/mrc/rocm_venv/bin/python3 tui.py
"""

import json
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

PROJECT = Path(__file__).resolve().parent
sys.path.insert(0, str(PROJECT))

from textual.app import App, ComposeResult  # noqa: E402
from textual.binding import Binding  # noqa: E402
from textual.screen import Screen  # noqa: E402
from textual.containers import Container  # noqa: E402
from textual.widgets import DataTable, Footer, Header, Static  # noqa: E402

DATA = PROJECT / "data"

LANE_COLOR = {
    "mom-k5": "cyan",
    "c08-fade": "green",
    "h1-mom": "yellow",
    "h1-rev": "blue",
    "h4-brk": "red",
    "d1-mom10": "green",
    "crash": "red",
    "watchdog": "magenta",
    "reconciled": "dim grey",
}


def _read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except Exception:
        return default


def attribute_lane(reason, symbol, qty=None, tag=None):
    """Map a ledger row's reason to a lane tag. Rows written since 2026-09-03
    carry an explicit venue-attributed `tag` (resolved from the opening fill's
    clientExtensions via tradeID — map #174 #175): that wins outright. Older
    tagless venue-reconciliation rows fall back to the fill-size matcher
    (mom-k5/c08 100u, h1-mom 2000u, crash 5000u) — grandfathered, never
    rewritten (append-only ledger)."""
    if tag:
        return tag
    r = reason or ""
    if r.startswith("c08"):
        return "c08-fade"
    if r.startswith("intraday"):
        return "h1-mom"
    if r.startswith("watchdog"):
        return "watchdog"
    if r.startswith("crash"):
        return "crash"
    if r.startswith("venue-reconciliation"):
        try:
            q = float(qty) if qty is not None else None
        except (TypeError, ValueError):
            q = None
        if q is not None:
            if q >= 5000:
                return "crash"
            if q >= 2000:
                return "h1-mom"
            if q > 0:
                return "mom-k5"
        return "reconciled"
    if r in ("momentum-entry", "out-of-target", "max-hold"):
        return "mom-k5"
    if r.startswith("mr-fade"):
        return "c08-fade"
    return "reconciled"


def ledger_performance():
    """Per-lane round trips, realized P&L (USD-approx: quote-ccy converted at
    exit rate), and win rate, FIFO-paired from the fill ledger."""
    rows = []
    try:
        for line in (DATA / "fx_ledger.jsonl").read_text().splitlines():
            if line.strip():
                rows.append(json.loads(line))
    except Exception:
        return {}
    rows.sort(key=lambda r: str(r.get("timestamp")))
    # append-only ledger corrections (map #158 #171): skip void rows and the
    # phantom fills they void — the venue never executed them
    _voided = {ts for r in rows if r.get("reason") == "phantom-void"
               for ts in (r.get("voids") or [])}
    rows = [r for r in rows if r.get("reason") != "phantom-void"
            and r.get("timestamp") not in _voided]
    lanes = {}
    for r in rows:
        lane = attribute_lane(r.get("reason"), r.get("symbol"), r.get("quantity"), r.get("tag"))
        sym = r.get("symbol")
        side = (r.get("side") or "").upper()
        qty = float(r.get("quantity") or 0)
        price = float(r.get("price") or 0)
        if not sym or sym == "-":
            continue
        book = lanes.setdefault(lane, {}).setdefault(sym, {"qty": 0.0, "cost": 0.0, "realized": 0.0, "wins": 0, "rounds": 0})
        if side == "BUY":
            book["qty"] += qty
            book["cost"] += qty * price
        elif side == "SELL" and book["qty"] > 1e-9:
            avg = book["cost"] / book["qty"]
            close_qty = min(qty, book["qty"])
            quote = sym.split("_")[1]
            pnl = (price - avg) * close_qty
            if quote not in ("USD",):  # profit realized in quote ccy → convert at exit
                pnl = pnl / price if price else 0.0
            book["realized"] += pnl
            book["rounds"] += 1
            book["wins"] += 1 if pnl > 0 else 0
            book["qty"] -= close_qty
            book["cost"] = avg * book["qty"]
    out = {}
    for lane, syms in lanes.items():
        realized = sum(b["realized"] for b in syms.values())
        rounds = sum(b["rounds"] for b in syms.values())
        wins = sum(b["wins"] for b in syms.values())
        out[lane] = {"realized": realized, "rounds": rounds,
                     "winrate": (100 * wins / rounds) if rounds else None}
    return out


def next_events():
    """Next central-bank decision touching any FX pair, + blackout pairs now."""
    try:
        from data.economic_calendar import bank_dates, blackout
        import datetime as dt
        now = datetime.now(timezone.utc)
        upcoming = []
        for bank in ("FED", "ECB", "BOE", "BOJ", "SNB", "BOC", "RBA", "RBNZ"):
            ds = sorted(d for d in bank_dates(bank) if d >= now.date())
            if ds:
                upcoming.append((ds[0], bank))
        upcoming.sort()
        blocked = []
        for pair in ("EUR_USD", "GBP_USD", "USD_JPY", "USD_CHF", "GBP_JPY",
                     "AUD_USD", "USD_CAD"):
            b, why = blackout(now, pair)
            if b:
                blocked.append(f"{pair}: {why}")
        return upcoming[:4], blocked
    except Exception:
        return [], []


def fetch_fx():
    """Live venue snapshot: dashboard /api/fx first (decoupled, cached), direct
    OANDA fallback."""
    try:
        import urllib.request
        with urllib.request.urlopen("http://127.0.0.1:8097/api/fx", timeout=5) as r:
            return json.load(r)
    except Exception:
        pass
    try:
        sys.path.insert(0, str(PROJECT))
        from exchange.oanda import OandaExchange
        from strategies.fx_runner import _venue_book
        ex = OandaExchange()
        if ex.connect():
            book = []
            for t in ex._request("GET", f"/v3/accounts/{ex._account_id}/openTrades").get("trades", []):
                book.append({"trade_id": t.get("id"), "instrument": t.get("instrument"),
                             "units": t.get("currentUnits"), "price": t.get("price"),
                             "opened": str(t.get("openTime", ""))[:19],
                             "owner": (t.get("clientExtensions") or {}).get("tag") or "unknown",
                             "pl": t.get("unrealizedPL"),
                             "protected": bool(t.get("stopLossOrder") or t.get("takeProfitOrder"))})
            acct = ex._request("GET", f"/v3/accounts/{ex._account_id}")["account"]
            return {"book": book, "balance": acct.get("balance"), "nav": acct.get("NAV"),
                    "fills": [], "registry": [], "queue": {}, "error": None}
    except Exception as e:
        return {"error": str(e), "book": [], "fills": [], "registry": [], "queue": {}}
    return {"error": "no data source", "book": [], "fills": [], "registry": [], "queue": {}}


def collect_all():
    """Everything both screens render. Runs in a worker thread."""
    fx = fetch_fx()
    ledger = ledger_performance()
    registry = _read_json(DATA / "epoch_registry.json", {"experts": []}).get("experts", [])
    router = _read_json(DATA / "live_router_state.json", {})
    crash = _read_json(DATA / "fx_crashtest.json", {})
    watchdog = _read_json(DATA / "fx_watchdog_state.json", {})
    upcoming, blocked = next_events()
    proposals = {"batches": 0, "survivors": 0, "last": None}
    try:
        for rep in sorted((DATA / "agent_gym" / "proposals").glob("*/report.md")):
            proposals["batches"] += 1
            proposals["last"] = rep.parent.name
            survivors = sum(1 for l in rep.read_text().splitlines() if "SURVIVOR" in l)
            proposals["survivors"] += survivors
    except Exception:
        pass
    router_experts = []
    try:
        for regime in ("up", "down"):
            track = (router.get("track") or {}).get(regime, {})
            for name, t in track.items():
                router_experts.append({"regime": regime, "name": name,
                                       "sum": t.get("sum"), "n": t.get("n")})
    except Exception:
        pass
    return {"fx": fx, "ledger": ledger, "registry": registry,
            "router_experts": router_experts, "crash": crash,
            "watchdog": watchdog, "upcoming": upcoming, "blocked": blocked,
            "proposals": proposals, "ts": datetime.now(timezone.utc)}


# ── render helpers ────────────────────────────────────────────────────────

def lane_line(tag, status, metric):
    color = LANE_COLOR.get(tag, "grey")
    return f"[{color}]●[/{color}] [{color}]{tag:<10}[/{color}] {status:<44} {metric}"


def pnl_color(v):
    if v is None:
        return "dim"
    return "green" if v >= 0 else "red"


# ── screens ───────────────────────────────────────────────────────────────

class MissionScreen(Screen):
    """Both pages in one screen: [1] Home, [2] Forex — toggled containers."""

    def compose(self) -> ComposeResult:
        with Container(id="home-wrap"):
            yield Static("", id="home_portfolio")
            yield DataTable(id="agents")
            yield Static("", id="home_system")
        with Container(id="forex-wrap"):
            yield Static("", id="fx_book")
            yield DataTable(id="positions")
            yield Static("", id="fx_lanes")
            yield DataTable(id="fills")
            yield Static("", id="fx_calendar")
    def on_mount(self):
        agents = self.query_one("#agents", DataTable)
        agents.cursor_type = "row"
        agents.add_columns("agent", "kind", "status", "performance", "last activity")
        agents.add_row("[dim]loading…[/dim]", "", "", "", "")
        positions = self.query_one("#positions", DataTable)
        positions.cursor_type = "row"
        positions.add_columns("trade", "instrument", "units", "entry", "opened (UTC)",
                              "owner", "unrealized", "SL/TP")
        fills = self.query_one("#fills", DataTable)
        fills.cursor_type = "row"
        fills.add_columns("time (UTC)", "symbol", "side", "qty", "price", "lane", "reason")
        self.set_interval(30, self.render_data)
        self.action_forex()  # default page: Forex
        self.action_home()

    def action_home(self):
        self.query_one("#home-wrap").display = True
        self.query_one("#forex-wrap").display = False

    def action_forex(self):
        self.query_one("#home-wrap").display = False
        self.query_one("#forex-wrap").display = True

    def render_data(self):
        state = self.app.state
        fx = state.get("fx", {})
        ledger = state.get("ledger", {})
        registry = state.get("registry", [])
        crash = state.get("crash", {})
        wd = state.get("watchdog", {})
        props = state.get("proposals", {})

        bal, nav = fx.get("balance"), fx.get("nav")
        open_pl = sum(float(t.get("pl") or 0) for t in fx.get("book", []))
        mom_real = (ledger.get("mom-k5") or {}).get("realized", 0)
        err = fx.get("error")
        self.query_one("#home_portfolio", Static).update(
            f"FX practice account  balance [b]${float(bal or 0):,.2f}[/b]  "
            f"NAV [b]${float(nav or 0):,.2f}[/b]  open unrealized "
            f"[{pnl_color(open_pl)}]{open_pl:+.2f}[/]"
            + (f"  [red]venue error: {err}[/red]" if err else "")
            + f"\nledger realized: mom-k5 [{pnl_color(mom_real)}]{mom_real:+.2f}[/]  "
            f"crash-book [{pnl_color(crash.get('realized'))}]{crash.get('realized', 0):+.2f}[/]  "
            f"·  crash-test $300 account: equity "
            f"[b]${300 + crash.get('realized', 0):,.2f}[/b] max DD ${crash.get('max_dd', 0):,.2f}")

        table = self.query_one("#agents", DataTable)
        table.clear()
        for e in registry:
            a = e.get("accrual") or {}
            table.add_row(f"[green]{e['expert_id']}[/]", f"registry {e.get('kind')}",
                          e.get("status", "?"), f"closed {a.get('closed_trades') if a.get('closed_trades') is not None else '—'}",
                          str((e.get('source') or '')[:46]))
        lr = ledger.get("mom-k5", {})
        table.add_row("[cyan]mom-k5[/]", "fx lane (daily)", "trading",
                      f"{lr.get('rounds', 0)} RT · WR {lr.get('winrate') or 0:.0f}%",
                      "momentum top-2, daily 17:10")
        cl = ledger.get("c08-fade", {})
        table.add_row("[green]c08-fade[/]", "fx lane (daily)", "armed — awaiting signal",
                      f"{cl.get('rounds', 0)} RT", "mr_fade_ma20_cot, daily 17:25")
        il = ledger.get("h1-mom", {})
        table.add_row("[yellow]h1-mom[/]", "fx lane (hourly)", "trading",
                      f"{il.get('rounds', 0)} RT", "H1 momentum, evidence velocity")
        table.add_row("[red]crash[/]", "crash-test book", "max-margin (unprotected)",
                      f"realized {crash.get('realized', 0):+.2f}",
                      "$300-equivalent gap experiment")
        table.add_row("[magenta]watchdog[/]", "shock response",
                      f"checked {str(wd.get('checked', '—'))[:19]}",
                      f"flattened {wd.get('flattened', 0)}", "gap/velocity guard, 15-min")
        for e in state.get("router_experts", [])[:4]:
            table.add_row(f"[cyan]{e['name']}[/]", f"equity router {e['regime']}",
                          "routing", f"sum {round(e['sum'], 2) if e['sum'] is not None else '—'}, n {e['n']}", "equities paper track")
        table.add_row("[grey]proposal_loop[/]", "discovery",
                      f"{props.get('survivors', 0)} survivor(s) / {props.get('batches', 0)} batches",
                      "~$0.01/batch", str(props.get("last") or "—"))

        upcoming, blocked = state.get("upcoming", []), state.get("blocked", [])
        cal = "  ·  ".join(f"{bank} {d}" for d, bank in upcoming) or "—"
        self.query_one("#home_system", Static).update(
            f"next monetary events: {cal}\n"
            + (("[red]blackout now: " + " · ".join(blocked) + "[/red]") if blocked
               else "event gate: [green]clear[/green]")
            + f"\npreference queue: [b]{fx.get('queue', {}).get('events', 0)}[/b] events, "
            f"{fx.get('queue', {}).get('labeled', 0)} labeled   ·   updated "
            f"{state.get('ts', datetime.now(timezone.utc)).strftime('%H:%M:%S UTC')}")

        # forex page
        book = fx.get("book", [])
        self.query_one("#fx_book", Static).update(
            f"balance [b]${float(bal or 0):,.2f}[/b] · NAV [b]${float(nav or 0):,.2f}[/b] · "
            f"unrealized [{pnl_color(open_pl)}]{open_pl:+.2f}[/] · "
            f"{len(book)} position(s) · venue is authoritative")
        pos_t = self.query_one("#positions", DataTable)
        pos_t.clear()
        for t in book:
            pl = float(t.get("pl") or 0)
            prot = "[green]yes[/]" if t.get("protected") else "[red]NO[/]"
            color = LANE_COLOR.get(t.get("owner"), "grey")
            pos_t.add_row(str(t.get("trade_id")), t.get("instrument"),
                          str(t.get("units")), str(t.get("price")),
                          str(t.get("opened")), f"[{color}]{t.get('owner')}[/{color}]",
                          f"[{pnl_color(pl)}]{pl:+.2f}[/]", prot)
        open_by_lane = {}
        for t in book:
            owner = t.get("owner") or "unknown"
            open_by_lane.setdefault(owner, {"n": 0, "pl": 0.0})
            open_by_lane[owner]["n"] += 1
            open_by_lane[owner]["pl"] += float(t.get("pl") or 0)
        lane_rows = []
        for tag in ("mom-k5", "c08-fade", "h1-mom", "crash", "watchdog"):
            l = ledger.get(tag, {})
            color = LANE_COLOR.get(tag, "grey")
            o = open_by_lane.get(tag)
            open_txt = (f" · [b]{o['n']} open[/b] [{pnl_color(o['pl'])}]{o['pl']:+.2f}[/]"
                        if o else "")
            realized = l.get("realized", 0)
            if tag == "crash" and crash.get("realized") is not None:
                # venue-derived tracker (fx_crashtest.json) is authoritative
                # for this lane — ledger FIFO pairs closes to the oldest open
                # buy, while the venue closes the newest position (SL/TP),
                # so per-pair totals diverge; the venue pl sum does not.
                realized = crash.get("realized", 0)
            else:
                realized = l.get("realized", 0)
            lane_rows.append(f"[{color}]●[/{color}] [{color}]{tag:<10}[/{color}] "
                             f"realized [{pnl_color(realized)}]{realized:+.2f}[/] · "
                             f"{l.get('rounds', 0)} RT · WR {(l.get('winrate') or 0):.0f}%"
                             + open_txt)
        cal2 = "\n".join(f"  {bank:<5} {d}" for d, bank in upcoming) or "  —"
        gate = ("[red]BLACKOUT: " + " · ".join(blocked) + "[/red]") if blocked \
            else "[green]clear — entries permitted[/green]"
        self.query_one("#fx_lanes", Static).update(
            "\n".join(lane_rows) + "\n\n[b]next monetary events[/b]\n" + cal2 +
            "\n[b]event gate[/b]: " + gate)
        fills_t = self.query_one("#fills", DataTable)
        fills_t.clear()
        for f in fx.get("fills", [])[:14]:
            lane = attribute_lane(f.get("reason"), f.get("symbol"), f.get("quantity"), f.get("tag"))
            color = LANE_COLOR.get(lane, "grey")
            fills_t.add_row(str(f.get("timestamp"))[:19], f.get("symbol"), f.get("side"),
                            str(f.get("quantity")), str(f.get("price")),
                            f"[{color}]{lane}[/{color}]", str(f.get("reason")))
        equity = 300 + crash.get("realized", 0)
        self.query_one("#fx_calendar", Static).update(
            f"[b]crash-test book[/b] (max-margin, $300-equivalent, unprotected by design) — "
            f"equity [b]${equity:,.2f}[/b] · realized [{pnl_color(crash.get('realized'))}]"
            f"{crash.get('realized', 0):+.2f}[/] · max DD ${crash.get('max_dd', 0):,.2f}")


class OpenTraderTUI(App):
    TITLE = "OpenTrader — terminal mission control"
    SUB_TITLE = "venue is authoritative · read-only"

    CSS = """
    Screen { background: #0b0f14; }
    Header { background: #101820; }
    #home-wrap, #forex-wrap { height: auto; }
    #home_portfolio, #home_system, #fx_book, #fx_lanes, #fx_calendar {
        background: #0e1620; border: round #1d2b38; padding: 0 1; margin: 0 0 1 0;
    }
    #agents, #positions, #fills { background: #0e1620; border: round #1d2b38;
        height: auto; max-height: 14; }
    #fx_calendar { color: #8aa2b8; }
    DataTable { background: #0e1620; }
    """

    BINDINGS = [
        Binding("1", "home", "Home"),
        Binding("2", "forex", "Forex"),
        Binding("r", "refresh", "Refresh"),
        Binding("q", "quit", "Quit"),
    ]

    state = {}

    def get_default_screen(self) -> Screen:
        """Boot directly onto the mission screen (Home default)."""
        return MissionScreen()

    def action_home(self):
        screen = self.screen
        screen.query_one("#home-wrap").display = True
        screen.query_one("#forex-wrap").display = False

    def action_forex(self):
        screen = self.screen
        screen.query_one("#forex-wrap").display = True
        screen.query_one("#home-wrap").display = False

    def action_refresh(self):
        self.update_data()

    def on_mount(self):
        self.update_data()
        self.set_interval(45, self.update_data)

    def update_data(self):
        self.run_worker(self._collect, thread=True, exclusive=True)

    def _collect(self):
        state = collect_all()
        self.call_from_thread(self._apply, state)

    def _apply(self, state):
        self.state = state
        screen = self.screen
        if hasattr(screen, "render_data"):
            screen.render_data()


if __name__ == "__main__":
    OpenTraderTUI().run()
